[Unit]
Description=Angelina AI Finance Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=angelina
WorkingDirectory=/opt/angelina
EnvironmentFile=/opt/angelina/.env
ExecStart=/opt/angelina/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
MemoryMax=2G

[Install]
WantedBy=multi-user.target
