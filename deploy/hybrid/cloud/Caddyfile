# Angelina Hybrid Cloud - Caddyfile for the Cloud Instance
# ---------------------------------------------------------------------------
# Caddy terminates HTTPS (automatic Let's Encrypt for the DuckDNS name) and
# reverse-proxies to Angelina bound on loopback 127.0.0.1:8080. Angelina's
# 8080 is never exposed publicly; only 80 (ACME) and 443 (HTTPS) are open.
#
# /audit is a token-protected, static self-audit report served directly by
# Caddy from /opt/angelina/static/audit (basic_auth; the app is untouched).
#
# ACME EMAIL - supply via the CADDY_EMAIL environment variable (e.g. in
# /etc/caddy/caddy.env referenced by the caddy systemd unit) or replace
# {$CADDY_EMAIL} with the operator's real address directly - but keep the real
# address OUT of version control.
#
# BASIC AUTH HASH - the /audit route is protected with HTTP basic auth. The
# password is the shared Access Token (the same one the Chat UI uses). Generate
# the bcrypt hash ON THE HOST and paste it below (the hash is one-way and safe
# to store; the plaintext token must never be committed):
#     caddy hash-password --plaintext '<THE_ACCESS_TOKEN>'
# Replace YOUR_BCRYPT_TOKEN_HASH with the resulting $2a$... string.
{
	email {$CADDY_EMAIL}
}
YOUR_SUBDOMAIN.duckdns.org {
	handle_path /audit* {
		basic_auth {
			angelina YOUR_BCRYPT_TOKEN_HASH
		}
		root * /opt/angelina/static/audit
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
