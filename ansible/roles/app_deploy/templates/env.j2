# {{ ansible_managed }}
# Angelina Hybrid Cloud — Cloud_Instance environment file.
# Rendered to {{ angelina_env_file }} (mode 0600, owner {{ angelina_user }}).
# ALL values come from Ansible vars — nothing is hardcoded here.
#
# INSTANCE_ROLE is 'cloud' on this VM (passive/failover) — NEVER 'local'.

# --- Instance identity ---
INSTANCE_ROLE={{ instance_role }}
INSTANCE_ID={{ instance_id }}

# --- Server bind (loopback only; Caddy reverse-proxies to it) ---
ANGELINA_HOST={{ angelina_host }}
ANGELINA_PORT={{ angelina_port }}
ANGELINA_LOG_LEVEL={{ angelina_log_level }}

# --- Secrets (from group_vars/all/vault.yml) ---
GEMINI_API_KEY={{ gemini_api_key }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_CHAT_ID={{ telegram_chat_id }}
ANGELINA_ACCESS_TOKEN={{ angelina_access_token }}
DUCKDNS_TOKEN={{ duckdns_token }}
SPREADSHEET_ID={{ spreadsheet_id }}
DRIVE_FOLDER_ID={{ drive_folder_id }}
ANGELINA_SYNC_FOLDER_ID={{ angelina_sync_folder_id }}
