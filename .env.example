# Angelina Finance Agent - Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.

# --- Core (local + cloud) ---
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SPREADSHEET_ID=your_google_sheet_id_here
DRIVE_FOLDER_ID=your_drive_knowledge_folder_id_here
ANGELINA_LOG_LEVEL=INFO
ANGELINA_HOST=0.0.0.0
ANGELINA_PORT=8080

# --- Hybrid Cloud: instance role ---
# "local" (primary, default) or "cloud" (passive failover backup).
# require_token is a NO-OP when INSTANCE_ROLE=local (no regression for LAN use).
INSTANCE_ROLE=local
INSTANCE_ID=local

# Presence window for failover (hours). Default 25 (24h heartbeat + 1h buffer).
# PRESENCE_WINDOW_HOURS=25

# --- Hybrid Cloud: remote access auth (required in cloud role) ---
# Shared Access Token presented via the X-Angelina-Token header for the public
# Chat UI / API. The app refuses to start in cloud role if this is unset.
ANGELINA_ACCESS_TOKEN=your_strong_access_token_here

# --- Hybrid Cloud: bi-directional HTTPS sync (set on the LOCAL instance) ---
# The peer instance's public HTTPS base URL, e.g. https://YOUR_SUBDOMAIN.duckdns.org
ANGELINA_PEER_URL=
# Request timeout for the sync exchange, seconds (default 120).
# ANGELINA_SYNC_TIMEOUT=120

# --- Hybrid Cloud: DuckDNS dynamic DNS (cloud instance) ---
DUCKDNS_TOKEN=your_duckdns_token_here

# --- Caddy ACME (cloud instance; set via /etc/caddy/caddy.env, not here) ---
# CADDY_EMAIL=you@example.com